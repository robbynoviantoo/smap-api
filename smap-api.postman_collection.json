        {
          "name": "Review Borrow - Reject",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset_borrow_pending/1/review", "host": ["{{baseUrl}}"], "path": ["api","v1","asset_borrow_pending","1","review"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"status\": \"rejected\",\n  \"reject_reason\": \"Asset sedang diperlukan internal\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
