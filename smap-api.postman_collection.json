            "url": { "raw": "{{baseUrl}}/api/v1/pengadaan_asset_pending/", "host": ["{{baseUrl}}"], "path": ["api","v1","pengadaan_asset_pending",""] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Monitor LG 27 inch\",\n  \"category\": \"Elektronik\",\n  \"merk\": \"LG\",\n  \"spec\": \"27 inch, 4K, IPS Panel\",\n  \"qty\": 2,\n  \"unit\": \"unit\",\n  \"priority\": \"high\",\n  \"request_date\": \"2026-04-02\",\n  \"remark\": \"Untuk kebutuhan tim desain\"\n}" }
