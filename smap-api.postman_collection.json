{
  "info": {
    "_postman_id": "smap-api-collection",
    "name": "SMAP API",
    "description": "SMAP Asset Management API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token",   "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","me"] }
          }
        },
        {
          "name": "Onboarding (First Login)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/onboarding", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","onboarding"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"first_name\": \"Budi\",\n  \"last_name\": \"Santoso\",\n  \"no_handphone\": \"08123456789\",\n  \"password\": \"RahasiaKuat123!\",\n  \"photo_cropped\": \"\"\n}" }
          }
        },
        {
          "name": "Get All Users (Superadmin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/", "host": ["{{baseUrl}}"], "path": ["api","v1","auth",""] }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api","v1","dashboard","stats"] }
          }
        }
      ]
    },
    {
      "name": "Asset",
      "item": [
        {
          "name": "Get Assets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/asset/?page=1&limit=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","asset",""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "name", "value": "", "disabled": true },
                { "key": "status", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Asset (→ Pending)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset/", "host": ["{{baseUrl}}"], "path": ["api","v1","asset",""] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Laptop Dell Latitude\",\n  \"no_asset\": \"AST-001\",\n  \"location\": \"Ruang IT\",\n  \"building\": \"Gedung A\",\n  \"category\": \"Elektronik\",\n  \"merk\": \"Dell\",\n  \"status\": \"good\"\n}" }
          }
        },
        {
          "name": "Update Asset",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset/", "host": ["{{baseUrl}}"], "path": ["api","v1","asset",""] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"id\": 1,\n  \"name\": \"Laptop Dell Updated\",\n  \"no_asset\": \"AST-001\",\n  \"location\": \"Ruang Server\",\n  \"building\": \"Gedung A\",\n  \"category\": \"Elektronik\",\n  \"merk\": \"Dell\",\n  \"status\": \"good\",\n  \"available_status\": \"available\"\n}" }
          }
        },
        {
          "name": "Delete Asset",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/v1/asset/1", "host": ["{{baseUrl}}"], "path": ["api","v1","asset","1"] }
          }
        },
        {
          "name": "Export Assets (Excel)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/asset/export", "host": ["{{baseUrl}}"], "path": ["api","v1","asset","export"] }
          }
        }
      ]
    },
    {
      "name": "Asset Pending",
      "item": [
        {
          "name": "Get All Pendings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset_pending/", "host": ["{{baseUrl}}"], "path": ["api","v1","asset_pending",""] }
          }
        },
        {
          "name": "Review Pending - Approve",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset_pending/1/review", "host": ["{{baseUrl}}"], "path": ["api","v1","asset_pending","1","review"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"status\": \"approved\"\n}" }
          }
        },
        {
          "name": "Review Pending - Reject",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset_pending/1/review", "host": ["{{baseUrl}}"], "path": ["api","v1","asset_pending","1","review"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"status\": \"rejected\",\n  \"reject_reason\": \"Data tidak lengkap\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Asset Maintenance",
      "item": [
        {
          "name": "Schedule Maintenance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset_maintenance/1/schedule", "host": ["{{baseUrl}}"], "path": ["api","v1","asset_maintenance","1","schedule"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"next_maintenance_date\": \"2026-06-01\"\n}" }
          }
        },
        {
          "name": "Start Maintenance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset_maintenance/1/start", "host": ["{{baseUrl}}"], "path": ["api","v1","asset_maintenance","1","start"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"notes\": \"Cek dan bersihkan komponen\"\n}" }
          }
        },
        {
          "name": "Finish Maintenance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset_maintenance/1/finish", "host": ["{{baseUrl}}"], "path": ["api","v1","asset_maintenance","1","finish"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"notes\": \"Selesai, semua komponen baik\",\n  \"next_maintenance_date\": \"2026-12-01\"\n}" }
          }
        },
        {
          "name": "Get All Maintenance Pendings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset_maintenance_pending/", "host": ["{{baseUrl}}"], "path": ["api","v1","asset_maintenance_pending",""] }
          }
        },
        {
          "name": "Review Maintenance Pending",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/asset_maintenance_pending/1/review", "host": ["{{baseUrl}}"], "path": ["api","v1","asset_maintenance_pending","1","review"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"status\": \"approved\"\n}" }
          }
        }
      ]
    },
